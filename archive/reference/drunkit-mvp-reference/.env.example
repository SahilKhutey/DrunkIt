ENVIRONMENT=development

# For local dev, leave as SQLite. For anything real, point at Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/drunkit_mvp
DATABASE_URL=sqlite:///./drunkit_mvp.db

# MUST be overridden with a real secret outside local dev.
ELIGIBILITY_TOKEN_SECRET=change-me-in-production

# Auto-creates tables on startup — only appropriate for local SQLite
# dev convenience. Set to false for Postgres/production and run
# `alembic upgrade head` instead (see README's Database migrations
# section). Ignored entirely when DATABASE_URL isn't sqlite.
AUTO_CREATE_TABLES=true

# IP-based rate limiting (slowapi) plus a per-phone OTP cooldown.
# Leave true except in automated tests, which disable it themselves.
RATE_LIMIT_ENABLED=true
