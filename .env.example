# ==========================================
# FACCP - Environment Configuration
# ==========================================
# Copy to .env and fill in real values
# NEVER commit .env to source control

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=INFO
ENVIRONMENT=local
SERVICE_NAMESPACE=faccp

# ---------- Infrastructure ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=faccp
POSTGRES_PASSWORD=faccp_dev_password_change_in_production
POSTGRES_DB=faccp

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=faccp-platform
KAFKA_CONSUMER_GROUP=faccp-group

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=faccp
MINIO_ROOT_PASSWORD=faccp_dev_password
MINIO_BUCKET=faccp-documents

# ---------- JWT / Auth ----------
JWT_SECRET=change-this-to-a-strong-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=faccp-platform
JWT_AUDIENCE=faccp-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SERVICE_TOKEN_EXPIRE_MINUTES=5

# ---------- MFA ----------
MFA_ISSUER=FACCP
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD=30
MFA_REQUIRED_ROLES=SUPER_ADMIN,REGULATORY_ADMIN,STATE_ADMIN,RETAILER_OWNER,STORE_MANAGER,DELIVERY_AGENT

# ---------- Encryption ----------
FIELD_ENCRYPTION_KEY=change-this-to-a-32-byte-base64-encoded-key

# ---------- Service URLs ----------
IDENTITY_SERVICE_URL=http://localhost:8001
CONSUMER_SERVICE_URL=http://localhost:8002
RETAILER_SERVICE_URL=http://localhost:8003
CATALOG_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8005
ORDER_SERVICE_URL=http://localhost:8006
COMPLIANCE_SERVICE_URL=http://localhost:8007
AUDIT_SERVICE_URL=http://localhost:8008
RISK_SERVICE_URL=http://localhost:8009
VERIFICATION_SERVICE_URL=http://localhost:8010
DELIVERY_SERVICE_URL=http://localhost:8011
NOTIFICATION_SERVICE_URL=http://localhost:8012
PAYMENT_SERVICE_URL=http://localhost:8013
PRICING_SERVICE_URL=http://localhost:8014
ANALYTICS_SERVICE_URL=http://localhost:8015
REALTIME_SERVICE_URL=http://localhost:8016

# ---------- Database URLs (per service) ----------
IDENTITY_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_identity
CONSUMER_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_consumer
RETAILER_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_retailer
CATALOG_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_catalog
INVENTORY_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_inventory
ORDER_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_order
COMPLIANCE_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_compliance
AUDIT_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_audit
RISK_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_risk
VERIFICATION_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_verification
DELIVERY_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_delivery
NOTIFICATION_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_notification
PAYMENT_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_payment
PRICING_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_pricing
ANALYTICS_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_analytics
REALTIME_DB_URL=postgresql+asyncpg://faccp:faccp_dev_password_change_in_production@localhost:5432/faccp_realtime

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=faccp
PROMETHEUS_MULTIPROC_DIR=/tmp

# ---------- Mail ----------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@faccp.local

# ---------- Rate Limiting ----------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=200

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ---------- Feature Flags ----------
FEATURE_MFA_ENFORCED=false
FEATURE_KYC_REQUIRED=true
FEATURE_POLICY_ENGINE_ENABLED=true
FEATURE_REAL_TIME_TRACKING=true
