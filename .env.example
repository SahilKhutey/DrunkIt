# FACCP Platform Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-faccp-development-signing-key-32bytes-minimum!

# Database Connections
POSTGRES_USER=faccp_admin
POSTGRES_PASSWORD=faccp_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Locks
REDIS_URL=redis://localhost:6379/0

# Kafka Event Backbone
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service URLs (Local Development)
IDENTITY_SERVICE_URL=http://localhost:8001
COMPLIANCE_SERVICE_URL=http://localhost:8002
RETAILER_SERVICE_URL=http://localhost:8003
CATALOG_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8005
ORDER_SERVICE_URL=http://localhost:8006
AUDIT_SERVICE_URL=http://localhost:8007

# Web Dashboard Ports
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
NEXT_PUBLIC_RETAILER_WEB_URL=http://localhost:3001
NEXT_PUBLIC_CONSUMER_WEB_URL=http://localhost:3002
