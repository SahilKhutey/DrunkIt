  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@faccp/shared-types": [
        "../shared-types/src/index.ts"
      ]
    },
    "outDir": "dist"
  },
  "include": [
    "src/**/*"
  ]
}